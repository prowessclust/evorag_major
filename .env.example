NEWSAPI_KEY=your_newsapi_key_here
GNEWS_KEY=your_gnews_key_here

# Hidden fallback: used if a persona's Ollama call is still running after
# GEMINI_FALLBACK_SECONDS (config.py, default 120s). Optional — leave blank
# to disable the fallback and keep the original Ollama-only behavior.
GEMINI_API_KEY=your_gemini_api_key_here
